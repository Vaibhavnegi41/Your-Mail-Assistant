{
  "manifest_version": 3,
  "name": "AI Email Assistant",
  "version": "1.0.0",
  "description": "Generate, review, and approve AI email drafts using LangGraph and Gmail.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Open AI Email Assistant"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
