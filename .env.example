# ==============================================
# AI Email Assistant - Environment Variables
# ==============================================

# Backend / FastAPI Configuration
PORT=8000
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000","chrome-extension://YOUR_EXTENSION_ID"]
SESSION_SECRET=your_random_session_secret_change_in_production

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_email_assistant

# LLM Configuration (OpenAI or compatible)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Pinecone Vector Database Configuration (RAG)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=email-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
